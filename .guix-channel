;;; .guix-channel --- channel metadata for the catallactics channel.
;;;
;;; `directory' keeps `guix pull' from compiling tests/ and scripts/ as
;;; channel modules; only catallactics/ is on the module load path.
;;;
;;; Nonguix is a declared dependency because the channel is developed
;;; alongside the fleet's Guix/Nonguix stack and future vendor/GUI packages
;;; use its binary build system.  The current modules use Guix build systems;
;;; users still add only this channel.

(channel
  (version 0)
  (directory "catallactics")
  (news-file "news.txt")
  (url "https://github.com/coldcatallactics/guix-catallactics")
  (keyring-reference "keyring")
  (dependencies
   (channel
    (name nonguix)
    (version 0)
    (url "https://gitlab.com/nonguix/nonguix")
    (introduction
     (channel-introduction
      (version 0)
      (commit "897c1a470da759236cc11798f4e0a5f7d4d59fbc")
      (signer
       "2A39 3FFF 68F4 EF7A 3D29  12AF 6F51 20A0 22FB B2D5"))))))
